---
// src/components/sections/Products.astro
import ProductCard from '../components/ProductCard.astro';

//TO-DO: Move to individual file
const products = [
    {
        category: 'TINTO RESERVA · 2019',
        name: 'Montserrat Selección',
        description: 'Monastrell y Tempranillo de viñas viejas. Aromas de fruta negra madura, cuero y especias. 24 meses en barrica de roble francés.',
        image: '/public/images/products/ejemplo_product.webp'
    },
    {
        category: 'BLANCO FERMENTADO · 2022',
        name: 'Clos Blanc',
        description: 'Macabeo y Mersequera de cosecha tardía. Notas de melocotón, flores blancas y mineral fresco. Fermentado en barrica.',
        image: '/public/images/products/ejemplo_product.webp'
    },
    {
        category: 'ROSADO JOVEN · 2023',
        name: 'Viña Rosada',
        description: 'Garnacha de alta expresión. Frambuesa, fresa silvestre y pétalo de rosa. Fresco y estructurado para toda la mesa.',
        image: '/public/images/products/ejemplo_product.webp'
    },
];
---

<section id="products" class="py-20 md:py-28 bg-background">
    <div class="container mx-auto px-4">
        
        <!-- Título de la sección -->
        <div class="w-full flex flex-col md:flex-row md:justify-between items-start md:items-end gap-2 md:gap-4 mb-16">
            <h2 class="font-fraunces text-3xl md:text-5xl lg:text-6xl text-white text-left">
                Nuestros productos
            </h2>

            <span class="font-work-sans text-paragraph text-sm uppercase text-left md:text-end w-fit">
                Lo mejor de nuestra bodega
            </span>
        </div>
        
        <!-- Grid dinámico de productos -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0.5">
            {products.map((product) => (
                <ProductCard 
                    category={product.category}
                    name={product.name}
                    description={product.description}
                    image={product.image}
                />
            ))}
        </div>
        
    </div>
</section>